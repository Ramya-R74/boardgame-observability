{
  "policy": {
    "_meta": { "description": "Lifecycle for boardgame application metrics" },
    "phases": {
      "hot": {
        "actions": {
          "rollover": { "max_primary_shard_size": "5gb", "max_age": "1d" },
          "set_priority": { "priority": 100 }
        }
      },
      "warm": {
        "min_age": "3d",
        "actions": { "forcemerge": { "max_num_segments": 1 }, "set_priority": { "priority": 50 } }
      },
      "delete": { "min_age": "90d", "actions": { "delete": {} } }
    }
  }
}
